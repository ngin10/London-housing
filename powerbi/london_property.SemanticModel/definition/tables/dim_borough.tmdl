	partition dim_borough = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_borough.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"borough", type text}, {"inner_outer", type text}, {"sales_count", Int64.Type}, {"coverage", type text}}, "en-GB")
				in
				    Typed
