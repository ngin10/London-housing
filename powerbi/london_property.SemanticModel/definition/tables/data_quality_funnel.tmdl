table data_quality_funnel
	lineageTag: 1ae0c5f9-3282-45b8-af7a-6f24f24585da

	column step_order
		dataType: int64
		isHidden
		lineageTag: 666ecab5-c62e-47d6-af0c-05b78301a693
		summarizeBy: none
		sourceColumn: step_order

	column step
		dataType: string
		sortByColumn: step_order
		lineageTag: ec9f7d2b-2cb8-4b8e-92ee-4378a30b17be
		summarizeBy: none
		sourceColumn: step

	column rows_remaining
		dataType: int64
		formatString: #,0
		lineageTag: efc8caad-e4ba-4645-a50b-4bbc21167bec
		summarizeBy: none
		sourceColumn: rows_remaining

	column rows_removed
		dataType: int64
		formatString: #,0
		lineageTag: 97a94a29-ead2-4c24-8ef6-849756c28ccf
		summarizeBy: none
		sourceColumn: rows_removed

	partition data_quality_funnel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "data_quality_funnel.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"step_order", Int64.Type}, {"step", type text}, {"rows_remaining", Int64.Type}, {"rows_removed", Int64.Type}}, "en-GB")
				in
				    Typed
