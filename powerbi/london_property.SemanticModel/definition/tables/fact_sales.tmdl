	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_sales.csv"), [Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"transaction_id", type text}, {"sale_date", type date}, {"price", Int64.Type}, {"price_band", type text}, {"price_band_order", Int64.Type}, {"borough", type text}, {"property_type", type text}, {"tenure", type text}, {"new_build", type text}, {"postcode", type text}, {"outward_code", type text}, {"postcode_sector", type text}, {"lsoa_code", type text}, {"latitude", type number}, {"longitude", type number}, {"crimes_12m", type number}, {"burglaries_12m", type number}}, "en-GB")
				in
				    Typed
