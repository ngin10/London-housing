	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_start", type date}, {"month_label", type text}, {"year_month", type text}, {"quarter", type text}, {"weekday", type text}, {"weekday_number", Int64.Type}, {"sdlt_period", type text}}, "en-GB")
				in
				    Typed
